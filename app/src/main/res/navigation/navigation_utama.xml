<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_utama"
    android:label="HOME"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="kelas.paba.navigation.HomeFragment"
        android:label="home"
        tools:layout="@layout/fragment_home"/>

    <fragment
        android:id="@+id/profileFragment"
        android:name="kelas.paba.navigation.ProfileFragment"
        android:label="profile"
        tools:layout="@layout/fragment_profile"
        >
        <action
            android:id="@+id/action_profileFragment_to_detailFragment"
            app:destination="@id/detailProfileFragment" />

    </fragment>

    <fragment
        android:id="@+id/settingFragment"
        android:name="kelas.paba.navigation.SettingFragment"
        android:label="setting"
        tools:layout="@layout/fragment_setting"/>

    <fragment
        android:id="@+id/detailProfileFragment"
        android:name="kelas.paba.navigation.DetailFragment"
        android:label="detail"
        tools:layout="@layout/fragment_detail"/>

</navigation>